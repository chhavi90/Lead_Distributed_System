generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  leads     Lead[]
}

model Provider {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  monthlyQuota        Int       @default(10)
  quotaResetDate      DateTime  @default(now())
  
  lastAssignedIndex   Int       @default(0)
  
  allocations         LeadAllocation[]
  quotaResets         QuotaReset[]
  webhookEvents       WebhookEvent[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Lead {
  id          String    @id @default(uuid())
  name        String
  phoneNumber String
  city        String
  description String
  serviceId   Int
  service     Service   @relation(fields: [serviceId], references: [id])
  
  @@unique([phoneNumber, serviceId], name: "unique_lead_per_service")
  
  allocations LeadAllocation[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LeadAllocation {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  providerId Int
  provider   Provider  @relation(fields: [providerId], references: [id])
  
  assignedAt DateTime  @default(now())
  
  @@unique([leadId, providerId], name: "unique_allocation")
  @@index([providerId])
  @@index([leadId])
}

model FairAllocationState {
  id              String    @id @default(uuid())
  serviceId       Int       @unique
  
  roundRobinState String    @default("0")
  
  updatedAt       DateTime  @updatedAt
  
  @@index([serviceId])
}

model QuotaReset {
  id          String    @id @default(uuid())
  providerId  Int
  provider    Provider  @relation(fields: [providerId], references: [id])
  
  webhookId   String    @unique 
  amount      Int       @default(10)
  
  createdAt   DateTime  @default(now())
}

model WebhookEvent {
  id          String    @id @default(uuid())
  externalId  String    @unique 
  providerId  Int
  provider    Provider  @relation(fields: [providerId], references: [id])
  
  eventType   String    
  payload     String  
  
  processed   Boolean   @default(false)
  processedAt DateTime?
  
  createdAt   DateTime  @default(now())
  
  @@index([externalId])
  @@index([providerId])
}

model AllocationLock {
  id          String    @id @default(uuid())
  leadId      String    @unique
  
  lockedAt    DateTime  @default(now())
  expiresAt   DateTime
}
